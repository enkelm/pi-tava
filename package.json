{
    "name": "pi-coop",
    "version": "0.14.0",
    "description": "Self-hosted Pi collaboration with durable shared conversations and private Herdr sessions",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enkelm/pi-coop.git"
    },
    "homepage": "https://github.com/enkelm/pi-coop#readme",
    "bugs": {
        "url": "https://github.com/enkelm/pi-coop/issues"
    },
    "bin": {
        "pi-coop": "bin/pi-coop.js"
    },
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/pi-coop.js",
        "dev": "node bin/pi-coop.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "build:terminal": "node scripts/build-herdr-web.mjs && node scripts/build-herdr-renderer.mjs",
        "build:terminal-renderer": "node scripts/build-herdr-renderer.mjs",
        "test:terminal-renderer": "node scripts/build-herdr-renderer.mjs --test && node --test test/terminal-renderer.test.ts test/terminal-renderer-preload.test.ts test/terminal-renderer-child.test.ts test/terminal-renderer-assets.test.ts test/terminal-grid-render.test.ts",
        "test:terminal-native": "node scripts/build-herdr-web.mjs --test",
        "test": "node --test test/*.test.ts",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/lsp-client": "^6.3.0",
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-agent-core": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-codemode": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "@earendil-works/pi-mcp": "1.4.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "blobatar": "2.7.0",
        "codemirror": "^6.0.2",
        "dompurify": "^3.4.16",
        "esbuild": "^0.28.2",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.1.0",
        "preact": "^11.0.1",
        "qrcode": "^1.5.4",
        "undici": "8.10.2",
        "vscode-jsonrpc": "^9.0.3",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@types/ws": "8.18.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
