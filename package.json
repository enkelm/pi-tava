{
    "name": "pi-coop",
    "version": "0.11.0",
    "description": "Self-hosted Pi collaboration with durable shared conversations and private Herdr sessions",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enkelm/pi-coop.git"
    },
    "homepage": "https://github.com/enkelm/pi-coop#readme",
    "bugs": {
        "url": "https://github.com/enkelm/pi-coop/issues"
    },
    "bin": {
        "pi-coop": "bin/pi-coop.js"
    },
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/pi-coop.js",
        "dev": "node bin/pi-coop.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "build:terminal": "node scripts/build-herdr-web.mjs",
        "test:terminal-native": "node scripts/build-herdr-web.mjs --test",
        "test": "node --test test/*.test.ts",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@earendil-works/chord": "1.1.0",
        "@earendil-works/pi-ai": "1.1.0",
        "@earendil-works/pi-codemode": "1.1.0",
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@earendil-works/pi-durable": "1.1.0",
        "dompurify": "^3.4.16",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.1.0",
        "preact": "^11.0.1",
        "qrcode": "^1.5.4",
        "undici": "8.10.2",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@types/ws": "8.18.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
