{
    "name": "pi-tava",
    "short_name": "pi-tava",
    "description": "Durable, multiplayer Pi agents in your browser",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#13141c",
    "theme_color": "#13141c",
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{ "name": "files", "accept": ["*/*"] }]
        }
    },
    "icons": [
        { "src": "/pi-tava-icon.svg", "sizes": "any", "type": "image/svg+xml" },
        { "src": "/pi-tava-icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/pi-tava-icon-512.png", "sizes": "512x512", "type": "image/png" },
        {
            "src": "/pi-tava-icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
